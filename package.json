{
  "name": "insta-shot",
  "description": "Multi-reference photography assistant — first mobile prototype.",
  "license": "0BSD",
  "version": "0.1.0",
  "main": "index.ts",
  "dependencies": {
    "expo": "^58.0.0",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.15",
    "expo-file-system": "~58.0.13",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-media-library": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-web": "^0.21.4",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "~19.3.0",
    "@types/ws": "^8.18.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/domain/*.test.ts server/*.test.ts",
    "setup:analysis": "node scripts/setup-analysis.mjs",
    "server": "node --experimental-strip-types --env-file=.env.local --env-file-if-exists=server/.env.local server/index.ts"
  }
}
